# Browser-facing application
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_URL=http://api:8000

# PostgreSQL / Redis
POSTGRES_DB=llmlab
POSTGRES_USER=llmlab
POSTGRES_PASSWORD=llmlab-local
DATABASE_URL=postgresql+psycopg://llmlab:llmlab-local@postgres:5432/llmlab
REDIS_URL=redis://redis:6379/0

# Optional cloud providers. Never expose these as NEXT_PUBLIC_*.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Optional local provider
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Multilingual RAG. BGE-M3 needs the optional API `rag` dependencies and a one-time model download.
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# Set true only when the API host may download the configured model. Otherwise the API reports and
# uses the built-in llmlab/multilingual-hash-v1 offline fallback.
RAG_ALLOW_MODEL_DOWNLOAD=false
RAG_KNOWLEDGE_DIR=knowledge/en
RAG_INDEX_DIR=apps/api/data/rag-index
RAG_CHUNK_TARGET_TOKENS=450
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_DENSE_WEIGHT=0.85
RAG_LEXICAL_WEIGHT=0.15
RAG_SCORE_THRESHOLD=0.14
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Reproducibility metadata
GIT_SHA=dev
