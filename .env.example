# Browser-facing application
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_URL=http://api:8000

# PostgreSQL / Redis
POSTGRES_DB=llmlab
POSTGRES_USER=llmlab
POSTGRES_PASSWORD=llmlab-local
DATABASE_URL=postgresql+psycopg://llmlab:llmlab-local@postgres:5432/llmlab
REDIS_URL=redis://redis:6379/0

# Optional cloud providers. Never expose these as NEXT_PUBLIC_*.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Optional local provider
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Reproducibility metadata
GIT_SHA=dev
